# Copier vers .env (jamais commité)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Clé partagée avec n8n (header X-API-Key). Générer : python -c "import secrets;print(secrets.token_urlsafe(32))"
# Si vide, le webhook refuse TOUTES les requêtes (fail closed).
WEBHOOK_API_KEY=

DATABASE_URL=sqlite:///./sophia.db
RAG_TOP_K=6
RAG_MIN_RELIABILITY=40
FEEDBACK_RELIABILITY=85
